{
  "id": "bimmhacks_tuner",
  "title": "Bimmhacks Tuner",
  "description": "Live gauges, a CSV datalogger with tuning, engine, per-cylinder, MHD-capture and your own custom PIDs, the engine unit's fault codes and, for a car that already runs a multi-map tune, map switching. Reads by default; never flashes or writes a tune",
  "version": "1.0.0",
  "vendor": "bimmhacks",
  "loggingId": "OABT",
  "iconGlyph": "engine",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusActualValueTorque2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Bimmhacks Tuner",
      "buttons": [
        [
          "BTN_ACTION",
          "Action"
        ],
        [
          "BTN_ACTION2",
          "More"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_PREV",
          "Previous page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "maps",
      "label": "Map switching (car already tuned)",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Off - nothing is sent"
        ],
        [
          "mhd",
          "MHD multi-map tune"
        ]
      ]
    },
    {
      "key": "dmeReads",
      "label": "Read engine unit values (boost, load, timing)",
      "type": "bool",
      "default": true
    },
    {
      "key": "packTuning",
      "label": "Log pack: Tuning (lambda, knock, ignition, trims ...)",
      "type": "bool",
      "default": true
    },
    {
      "key": "packEngine",
      "label": "Log pack: Engine (VANOS, oil pressure, exhaust ...)",
      "type": "bool",
      "default": false
    },
    {
      "key": "packCylinders",
      "label": "Log pack: Cylinders (ignition, rough running, misfires)",
      "type": "bool",
      "default": false
    },
    {
      "key": "packMhd",
      "label": "Log pack: MHD capture (8 identifiers, raw hex)",
      "type": "bool",
      "default": false
    },
    {
      "key": "packCustom",
      "label": "Log pack: Custom (custom_pids.json)",
      "type": "bool",
      "default": true
    },
    {
      "key": "logRate",
      "label": "Datalog rate",
      "type": "number",
      "unit": "Hz",
      "default": 2,
      "markDefault": true,
      "steps": [
        1,
        2,
        5
      ]
    },
    {
      "key": "speedUnit",
      "label": "Speed unit",
      "type": "choice",
      "default": "kmh",
      "options": [
        [
          "kmh",
          "km/h"
        ],
        [
          "mph",
          "mph"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    }
  ],
  "config": {
    "comment": "No scaling here: kit/car.js uses BMW's own. dme = the engine unit values, see its comment.",
    "dme": {
      "comment": "Engine unit (DME, 0x12; ecu 18 = 0x12) values, read with UDS 0x22 over the read-only diagnostic link. The candidate lists are M Vitals' own (idrive7-apps, MIT): the first candidate the car answers with a plausible number wins. value = raw * factor + offset. boost values are absolute kPa; the page shows gauge boost = absolute - outside air pressure (baro).",
      "ecu": 18,
      "iat": [
        {
          "did": "F40F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150
        },
        {
          "did": "F477",
          "bytes": 1,
          "at": 1,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150,
          "note": "charge air cooler temperature, bank 1 sensor 1"
        },
        {
          "obd": "0F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150,
          "note": "the same PID with OBD service 01, for engine units that refuse F40F with NRC 31"
        }
      ],
