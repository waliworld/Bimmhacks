# BMW's SDK and everything built with it: made per car by the installer, never committed or shipped
oap-sdk/
dist/
*.mgu
# Per-car SSH keys and logs written by the root-access tool: never commit
tools/idrive7-8-ssh-root/data/enrollments/
tools/idrive7-8-ssh-root/data/logs/
id_rsa
id_rsa.*
*.ppk
.bimmhacks-installer.json
# coding snapshots contain a car's VIN: keep them local
coding-backups/
# the Store package a Pocket box downloads for itself (installer/pocket_server.py)
pocket-store/
__pycache__/
*.pyc
.DS_Store

# but DO keep the shared flash assets the root-access tool needs
!tools/idrive7-8-ssh-root/data/assets/
!tools/idrive7-8-ssh-root/data/assets/*
